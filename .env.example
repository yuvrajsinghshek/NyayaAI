# ── Groq API ──────────────────────────────────────────
# Get free key: console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Embeddings Model ──────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Groq Model ────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile

# ── ChromaDB Path ─────────────────────────────────────
CHROMA_DB_PATH=ai/data/chroma_db

# ── RAG Settings ──────────────────────────────────────
TOP_K_RESULTS=3

# ── App Settings ──────────────────────────────────────
APP_NAME=NyayaAI
APP_VERSION=1.0.0

# ── PostgreSQL Database ───────────────────────────────
# Local development:
# Install PostgreSQL from postgresql.org
# Create database named nyayaai_db in pgAdmin
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nyayaai_db
# DB_USER=postgres
# DB_PASSWORD=your_local_password

# Production (Railway):
# Copy DATABASE_URL from Railway PostgreSQL service
DATABASE_URL=your_railway_database_url_here
DB_HOST=your_railway_host.proxy.rlwy.net
DB_PORT=your_railway_port
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=your_railway_password

# ── Email Settings ────────────────────────────────────
# Gmail App Password: myaccount.google.com/apppasswords
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_FROM=your_gmail@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ── JWT Settings ──────────────────────────────────────
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
